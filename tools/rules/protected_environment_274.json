      "count": 1,
      "translation": "更新 Conda 失败："
    },
    {
      "path": "widgets/main_window/environment_components.py",
      "id": "pbe.update_failed_title",
      "original": "title='Update Failed'",
      "template": "title={text}",
      "count": 1,
      "translation": "更新失败"
    },
    {
      "path": "widgets/main_window/environment_components.py",
      "id": "pbe.update_success_message",
      "original": "text='Conda has been updated successfully.'",
      "template": "text={text}",
      "count": 1,
      "translation": "Conda 已成功更新。"
    },
    {
      "path": "widgets/main_window/environment_components.py",
      "id": "pbe.update_success_title",
      "original": "title='Update Complete'",
      "template": "title={text}",
      "count": 1,
      "translation": "更新完成"
    },
    {
      "path": "widgets/main_window/application_components.py",
      "id": "pbe.app_cannot_modify",
