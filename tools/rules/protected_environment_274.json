    {
      "path": "widgets/main_window/application_components.py",
      "id": "pbe.select_environment",
      "original": "'Please select an environment:'",
      "template": "{text}",
      "count": 1,
      "translation": "请选择一个环境："
    },
    {
      "path": "widgets/main_window/application_components.py",
      "id": "pbe.creating_environment",
