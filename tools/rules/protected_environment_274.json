
{
  "version": "2.7.4",
  "rules": [
    {
      "path": "widgets/main_window/environment_components.py",
      "id": "pbe.conda_self_missing",
      "original": "text='The conda-self package is not installed in the base environment.'",
      "template": "text={text}",
      "count": 1,
      "translation": "base 环境中未安装 conda-self 软件包。"
    },
    {
